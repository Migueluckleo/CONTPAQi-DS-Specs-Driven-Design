{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blueheart:catalog.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "version": {
            "$ref": "common.schema.json#/$defs/version"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "current": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "version",
          "path",
          "sha256",
          "current"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "token_sets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "version": {
            "$ref": "common.schema.json#/$defs/version"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "current": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "version",
          "path",
          "sha256",
          "current"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "contracts",
    "token_sets"
  ],
  "additionalProperties": false
}
