{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blueheart:component.schema.json",
  "allOf": [
    {
      "$ref": "contract.schema.json"
    },
    {
      "properties": {
        "profile": {
          "const": "component"
        },
        "profile_data": {
          "type": "object",
          "properties": {
            "anatomy": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "composition": {
              "type": "string",
              "minLength": 1
            },
            "accessibility": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "anatomy",
            "composition",
            "accessibility"
          ],
          "additionalProperties": false
        }
      }
    }
  ]
}
