{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blueheart:token-set.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "default_mode": {
            "type": "string",
            "minLength": 1
          },
          "modes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "name"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "name",
          "default_mode",
          "modes"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "layer": {
            "enum": [
              "primitive",
              "semantic",
              "component"
            ]
          },
          "type": {
            "enum": [
              "color",
              "number",
              "string",
              "boolean"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "scopes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": ["FRAME_FILL", "SHAPE_FILL", "TEXT_FILL", "STROKE_COLOR", "STROKE_FLOAT", "EFFECT_COLOR", "EFFECT_FLOAT", "WIDTH_HEIGHT", "GAP", "CORNER_RADIUS", "OPACITY", "FONT_FAMILY", "FONT_STYLE", "FONT_WEIGHT", "FONT_SIZE", "LINE_HEIGHT", "LETTER_SPACING", "TEXT_CONTENT", "PARAGRAPH_SPACING", "PARAGRAPH_INDENT"]
            }
          },
          "collection": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "values": {
            "type": "object"
          },
          "source": {
            "allOf": [
              {
                "$ref": "common.schema.json#/$defs/source"
              },
              {
                "required": [
                  "original_id",
                  "selector"
                ]
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "layer",
          "type",
          "description",
          "collection",
          "values",
          "source"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "collections",
    "tokens"
  ],
  "additionalProperties": false
}
