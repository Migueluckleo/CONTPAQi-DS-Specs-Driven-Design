{
  "name": "@contpaqi/design-system-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.tsx",
    "test:browser": "playwright test",
    "ds:generate": "python3 scripts/generate.py",
    "ds:check": "python3 scripts/generate.py --check",
    "verify": "pnpm ds:check && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@fontsource-variable/manrope": "5.3.0"
  },
  "devDependencies": {
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "typescript": "7.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.5",
    "postcss": "8.5.30",
    "tsx": "4.23.15",
    "@playwright/test": "1.64.0",
    "@axe-core/playwright": "4.13.0"
  }
}
