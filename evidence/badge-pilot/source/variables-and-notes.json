    },
    {
      "id": "8891:706",
      "name": "Type",
      "text": "Type"
    },
    {
      "id": "8891:707",
      "name": "Description",
      "text": "Changes the visual appearance of the Button. Combine variants with tones to create different levels of visual emphasis and hierarchy."
    },
    {
      "id": "8891:711",
      "name": "title",
      "text": "Casos de uso:"
    },
    {
      "id": "8891:713",
      "name": "text",
      "text": "success, warning y error: estados de procesos fiscales y de cobranza. Ej. CFDI Vigente o Timbrado (success), Por vencer o Pendiente de timbrar (warning), Cancelado o Error de timbrado (error)."
    },
    {
      "id": "8891:1380",
      "name": "title",
      "text": "Casos de uso:"
    },
    {
      "id": "8891:1382",
      "name": "text",
      "text": "info: estados en curso o informativos, p. ej. En proceso o Enviado al SAT."
    },
    {
      "id": "8891:1387",
      "name": "title",
      "text": "Casos de uso:"
    },
    {
      "id": "8891:1389",
      "name": "text",
      "text": "subtle y neutral: atributos sin estado como PUE, PPD, MXN o Borrador. neutral solo sobre superficies de color; sobre blanco usa subtle."
    },
    {
      "id": "8891:720",
      "name": "Size",
      "text": "Size"
    },
    {
      "id": "8891:721",
      "name": "Description",
      "text": "Changes the visual appearance of the Button. Combine variants with tones to create different levels of visual emphasis and hierarchy."
    },
    {
      "id": "8891:725",
      "name": "title",
      "text": "Casos de uso:"
    },
    {
      "id": "8891:727",
      "name": "text",
      "text": "small (20 px): celdas de tablas densas y listas compactas."
    },
    {
      "id": "8891:1469",
      "name": "title",
      "text": "Casos de uso:"
    },
    {
      "id": "8891:1471",
      "name": "text",
      "text": "medium (24 px): tablas, tarjetas y listas. Tamaño estándar."
    },
    {
      "id": "8891:1476",
      "name": "title",
      "text": "Casos de uso:"
    },
    {
      "id": "8891:1478",
      "name": "text",
      "text": "large (32 px): encabezado de un detalle (factura, póliza, expediente)."
    },
    {
      "id": "8891:734",
      "name": "Icons",
      "text": "Icons"
    },
    {
      "id": "8891:735",
      "name": "Description",
      "text": "Changes the visual appearance of the Button. Combine variants with tones to create different levels of visual emphasis and hierarchy."
    },
    {
      "id": "8891:739",
      "name": "title",
      "text": "Casos de uso:"
    },
    {
      "id": "8891:741",
      "name": "text",
      "text": "El ícono izquierdo refuerza estados críticos (check en success, alerta en warning y error, info en info). El texto siempre describe el estado: el color y el ícono nunca son el único medio. Vienen apagados por defecto."
    }
  ]
}
